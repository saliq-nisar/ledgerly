# ---------------------------------------------------------------------------
# ALL VARIABLES ARE OPTIONAL.
#
# The documentation site, diagrams, playgrounds and simulations work with no
# environment variables at all:  npm install && npm run dev
#
# These are only required for the optional *real Stripe test* (creating real
# test-mode Checkout Sessions and receiving webhooks). To enable it, copy this
# file to .env.local (git-ignored) and fill in your own Stripe TEST-MODE values:
#   https://dashboard.stripe.com/test/apikeys
#
# Never commit real keys. Never prefix a secret with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Optional — only required for real Stripe testing. Server-side secret key (sk_test_…).
STRIPE_SECRET_KEY=

# Optional — only required to receive real webhooks. Signing secret (whsec_…),
# printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=

# Optional — public origin used for Stripe redirect URLs. Defaults to
# http://localhost:3000 for local testing.
APP_URL=http://localhost:3000

# Optional — "test" (default) requires sk_test_ keys; "production" requires
# sk_live_ keys and an https APP_URL. Never switched automatically.
PAYMENTS_ENVIRONMENT=test
